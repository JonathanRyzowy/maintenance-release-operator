{
  "compilerOptions": {
    "allowJs": true,
    "checkJs": true,
    "noEmit": true,
    "module": "NodeNext",
    "moduleResolution": "NodeNext",
    "target": "ES2022",
    "lib": ["ES2022"],
    "skipLibCheck": true,
    "strict": false
  },
  "include": ["src/**/*.js", "tests/**/*.js"],
  "exclude": ["node_modules", "tests/fixtures"]
}
