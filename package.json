{
  "name": "maintenance-release-operator",
  "version": "0.1.1",
  "description": "CLI tool to check repo health and automate maintenance tasks",
  "type": "module",
  "bin": {
    "maintenance-release-operator": "./src/index.js",
    "mro": "./src/index.js"
  },
  "main": "./src/index.js",
  "packageManager": "npm@11.9.0",
  "scripts": {
    "test": "node --test tests/*.test.js",
    "lint": "eslint .",
    "format:check": "prettier --check src tests package.json action.yml .github/workflows/ci.yml .mrorc.schema.json",
    "typecheck": "tsc --noEmit",
    "ci": "npm run lint && npm run format:check && npm run typecheck && npm run test",
    "start": "node src/index.js"
  },
  "keywords": [
    "maintenance",
    "release",
    "automation",
    "agent",
    "devops",
    "cli",
    "repo-health",
    "changelog",
    "dependencies",
    "developer-tools",
    "developer-experience",
    "repository-maintenance",
    "git-workflow",
    "semantic-versioning",
    "ci-cd",
    "version-management",
    "release-automation"
  ],
  "author": "JonathanRyzowy",
  "license": "MIT",
  "engines": {
    "node": ">=18.0.0"
  },
  "files": [
    "src/**/*",
    "README.md",
    "LICENSE"
  ],
  "repository": {
    "type": "git",
    "url": "https://github.com/JonathanRyzowy/maintenance-release-operator.git"
  },
  "bugs": {
    "url": "https://github.com/JonathanRyzowy/maintenance-release-operator/issues"
  },
  "homepage": "https://github.com/JonathanRyzowy/maintenance-release-operator#readme",
  "devDependencies": {
    "@eslint/js": "^9.18.0",
    "@types/node": "^26.0.1",
    "eslint": "^9.18.0",
    "prettier": "^3.4.2",
    "typescript": "^5.7.2"
  }
}
